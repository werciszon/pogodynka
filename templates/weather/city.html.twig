{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecasts \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.name }}, {{ location.country }}</h1>

        <ul>
            {% for forecast in forecasts %}
                <li>{{ forecast.date|date('d.m.Y') }}</li>
                <li>temperature: {{ forecast.temperature }}&deg;C:</li>
                <li>cloudiness: {{ forecast.cloudiness }}%</li>
                <li>humiduty: {{ forecast.humidity }}%</li>
                <li>precipitation: {{ forecast.precipitation }}%</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
